# Module 3 settings. Copy to .env (git-ignored) and edit:  cp .env.example .env
# The first block is the module 2 inference contract; copy your values from m2/.env.

# Inference connection contract (module 1 gateway on the GPU host)
INFERENCE_BASE_URL=http://<MODEL_HOST>:8080/v1
INFERENCE_MODEL=qwen3-14b
INFERENCE_TIMEOUT_SECONDS=120
# Per-model request extras. Qwen and Granite: disable thinking. Llama: use '{}'.
INFERENCE_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
INFERENCE_TOOL_CALLING=native
INFERENCE_STRUCTURED_OUTPUT=json_schema
# Retries for connection errors, 5xx, and timeouts on each model call (the OpenAI client retries with backoff)
INFERENCE_MAX_RETRIES=2

# Agent and workflow budgets
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_OUTPUT_TOKENS=800
WORKFLOW_MAX_NUDGES=1
WORKFLOW_MAX_CORRECTIONS=1
WORKFLOW_RUN_TIMEOUT_SECONDS=90

# Case API client: timeout per request and retry budget (timeouts and 5xx only)
CASE_API_TIMEOUT_SECONDS=3
CASE_API_RETRIES=2
CASE_API_BACKOFF_SECONDS=0.5

# Application context
TACO_POLICY_VERSION=2026.09

# Enables the admin routes (fault injection, fixture reset) on the case API and the complaint API.
# Demo-only value; leave empty to disable the admin routes entirely.
TACO_ADMIN_TOKEN=change-me-demo-admin

# Published ports. Loopback by default. Podman inside WSL2 (NAT networking) with a browser on Windows:
# if http://127.0.0.1:8090/ui does not open from Windows, set PUBLISH_ADDRESS=0.0.0.0 and browse to the
# WSL address (`hostname -I` in WSL). The WSL NAT address is reachable only from this Windows host.
# Never use 0.0.0.0 on a machine with a LAN-facing interface: the actor header is unauthenticated.
PUBLISH_ADDRESS=127.0.0.1
CASE_API_PORT=8081
COMPLAINT_API_PORT=8090

# Host paths for results (relative to m3/)
RESULTS_DIR=./results
M1_RESULTS_DIR=../m1/results
M2_RESULTS_DIR=../m2/results

# Concurrent workflow runs in the single API worker; further requests wait up to the queue timeout, then 503.
WORKFLOW_MAX_CONCURRENT_RUNS=4
WORKFLOW_QUEUE_TIMEOUT_SECONDS=60

# LangSmith tracing (module 4). The complaint API reads LANGSMITH_* from this file; the default turns
# tracing off. Module 4: TRACING_ENV_FILE=../m4/.env (unquoted values; see m4/.env.example).
TRACING_ENV_FILE=./tracing-off.env
