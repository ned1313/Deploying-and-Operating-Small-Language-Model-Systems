{
  "uid": "taco-quality",
  "title": "Quality and cost",
  "description": "Module 5: sampled output quality by model, the review queue, and an estimated cost per successful resolution. Quality ratios cover the last 20 scored samples; run the quality tool to score new ones.",
  "tags": [
    "taco-alley",
    "module-5"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "taco-alley"
      ],
      "asDropdown": false,
      "title": "Taco Alley"
    }
  ],
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "hourly_cost",
        "label": "Hourly cost (USD)",
        "query": "0.24",
        "current": {
          "text": "0.24",
          "value": "0.24"
        },
        "options": [
          {
            "selected": true,
            "text": "0.24",
            "value": "0.24"
          }
        ],
        "description": "On-prem estimate from tools/.env defaults: amortized host + GPU power + desktop share."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Checks pass (last 20)",
      "description": "Deterministic checks on the sampled proposals (QualityDegraded below 90%).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(taco_quality_recent_ratio{signal=\"checks_passed\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.9,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Label pass (last 20)",
      "description": "grade() against the synthetic labels; production traffic has none.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(taco_quality_recent_ratio{signal=\"label_passed\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.78,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 4,
        "y": 0
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Successful (last 20)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(taco_quality_recent_ratio{signal=\"successful\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.8,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 8,
        "y": 0
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Review queue",
      "description": "Flagged samples without a human review. Work them at /ui/quality?actor=qa-01.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(taco_quality_review_queue)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              },
              {
                "value": 10,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 12,
        "y": 0
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Unscored samples",
      "description": "Run `podman-compose run --rm quality score` from tools/.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(taco_quality_unscored)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 16,
        "y": 0
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Cost per successful resolution",
      "description": "Hourly cost (dashboard variable) / (recorded per hour x successful share). The cost report has the exact numbers and assumptions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "$hourly_cost / clamp_min(sum(rate(taco_workflow_runs_total{status=~\"recorded|escalated\"}[15m])) * 3600 * scalar(min(taco_quality_recent_ratio{signal=\"successful\"})), 1e-9)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 20,
        "y": 0
      },
      "id": 6
    },
    {
      "type": "row",
      "title": "Quality by model",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 4
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Quality signals (last 20 scored samples)",
      "description": "Each point is the window at that moment; a model swap shows up as a new series.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "taco_quality_recent_ratio",
          "legendFormat": "{{model}} {{signal}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 5
      },
      "id": 8
    },
