      "type": "timeseries",
      "title": "Recorded resolutions per hour",
      "description": "Approved actions recorded through the case API, from the application's own counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
