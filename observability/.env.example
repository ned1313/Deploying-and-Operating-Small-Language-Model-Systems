# Observability settings. Copy to .env (git-ignored) and edit:  cp .env.example .env

# GPU host (gateway and exporters)
MODEL_HOST=192.168.1.251
GATEWAY_PORT=8080
NODE_EXPORTER_PORT=9100
GPU_EXPORTER_PORT=9400

# Desktop ports for Prometheus and Grafana. Loopback by default; see app/.env.example for WSL notes.
PUBLISH_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=30d

# Module 6: scrape vLLM, node, and GPU metrics through the TLS gateway with the prometheus client
# certificate (secrets/certs/prometheus). Job and instance labels do not change.
# PROMETHEUS_CONFIG=prometheus.secure.yml
# GATEWAY_TLS_PORT=8443
