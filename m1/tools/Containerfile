FROM docker.io/library/python:3.12-slim

# Build context is the repository root (see m1/compose.yaml).
WORKDIR /app
COPY shared/requirements/core.txt /tmp/core.txt
RUN pip install --no-cache-dir -r /tmp/core.txt
COPY shared/ /opt/shared/
RUN pip install --no-cache-dir --no-deps /opt/shared

COPY m1/tools/*.py /app/tools/

# The compose `tools` service mounts ${RESULTS_DIR} here.
ENV RESULTS_DIR=/app/results
RUN mkdir -p /app/results

ENTRYPOINT ["python"]
CMD ["tools/smoke_test.py", "--help"]
