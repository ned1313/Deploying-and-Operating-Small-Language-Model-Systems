# Module 4 settings. Copy to .env (git-ignored) and edit:  cp .env.example .env
#
# The complaint API (run from m3/) also reads this file through TRACING_ENV_FILE=../m4/.env in m3/.env.
# Podman passes env-file values literally, so do not quote values (no "..." or '...').

# GPU host (module 1 gateway and the module 4 exporters)
MODEL_HOST=192.168.1.251
GATEWAY_PORT=8080
NODE_EXPORTER_PORT=9100
GPU_EXPORTER_PORT=9400

# Desktop ports for Prometheus and Grafana. Loopback by default; see m3/.env.example for WSL notes.
PUBLISH_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=30d

# Direct-inference load (same values as m3/.env, unquoted)
INFERENCE_MODEL=qwen3-14b
INFERENCE_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Same value as m3/.env: the app load workload resets its cases through the admin routes
TACO_ADMIN_TOKEN=change-me-demo-admin

# Results (relative to m4/) and where the load generator runs (recorded with every result)
RESULTS_DIR=./results
EXECUTION_HOST=desktop

# LangSmith tracing for the complaint API (synthetic data only). The key stays in this git-ignored file.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=taco-alley
# Share of runs exported (1.0 = all). Lower it in production; errors are no more likely to be sampled.
LANGSMITH_TRACING_SAMPLING_RATE=1.0
# Redaction switch: true replaces inputs and outputs in exported traces (structure and timings remain).
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
