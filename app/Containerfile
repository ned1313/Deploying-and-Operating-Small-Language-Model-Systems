FROM docker.io/library/python:3.12-slim

# Build context is the repository root (see app/compose.yaml). One image runs the complaint API, the
# case API, the seed job, the CLI, and the module 2 teaching script. Tests run from the tools image.
WORKDIR /app
COPY shared/requirements/app.txt /tmp/app.txt
RUN pip install --no-cache-dir -r /tmp/app.txt
COPY shared/ /opt/shared/
RUN pip install --no-cache-dir --no-deps /opt/shared

COPY app/complaint_api/ /app/complaint_api/
COPY app/case_api/ /app/case_api/
COPY app/clients/ /app/clients/
COPY app/examples/ /app/examples/

# Set at build time (APP_VERSION=$(git rev-parse --short HEAD)); reported as taco_build_info{app_version}.
ARG APP_VERSION=dev
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    TACO_APP_VERSION=${APP_VERSION} \
    RESULTS_DIR=/app/results \
    TACO_STATE_DIR=/data/state
RUN mkdir -p /app/results /data/state

# Health checks are defined per service in app/compose.yaml (this image serves two APIs).
EXPOSE 8090 8081
CMD ["uvicorn", "complaint_api.main:app", "--host", "0.0.0.0", "--port", "8090", "--workers", "1"]
