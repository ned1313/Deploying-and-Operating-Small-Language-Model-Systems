# Tools settings. Copy to .env (git-ignored) and edit:  cp .env.example .env
# Each host has its own checkout and its own tools/.env.

# Inference endpoint (gateway on the GPU host).
#   Desktop:   http://<MODEL_HOST>:8080/v1
#   GPU host:  http://host.containers.internal:8080/v1   (the gateway's published port, from a container)
INFERENCE_BASE_URL=http://<MODEL_HOST>:8080/v1

# Model settings for agent-eval and direct load. Same values as app/.env; keep them in step.
# The serving tools (smoke, screen, load-sweep) ignore these and take --model / --extra-body flags.
INFERENCE_MODEL=taco-slm
INFERENCE_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
INFERENCE_TOOL_CALLING=native
INFERENCE_STRUCTURED_OUTPUT=json_schema
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_OUTPUT_TOKENS=800
TACO_POLICY_VERSION=2026.09

# Same value as app/.env: the harnesses and the app load workload reset cases through the admin routes.
TACO_ADMIN_TOKEN=change-me-demo-admin

# Where the load generator runs (recorded with every load result): desktop | gpu-host
EXECUTION_HOST=desktop

# Cost assumptions for the `cost` report (module 5). Placeholders: replace with your own numbers;
# every report prints the values it used.
# On-premises: GPU host purchase price amortized over N years, plus measured GPU power and a fixed
# host overhead at your electricity rate, plus a share of the desktop that runs the application.
COST_GPU_HOST_PRICE_USD=3000
COST_AMORTIZATION_YEARS=3
COST_ELECTRICITY_USD_PER_KWH=0.15
COST_HOST_OVERHEAD_WATTS=120
COST_DESKTOP_SHARE_USD_PER_HOUR=0.05
# Cloud-equivalent: on-demand price of a comparable 24 GB GPU instance.
COST_CLOUD_GPU_USD_PER_HOUR=1.00
# Optional human review cost per recorded case (0 leaves it out).
COST_REVIEW_USD_PER_CASE=0

# ----- Module 6: secured request path (see m6/README.md). Leave commented for modules 1-5. -----------
# The model gateway over TLS with the tools client certificate (scripts/issue-certs.sh):
# INFERENCE_BASE_URL=https://slm.taco.internal:8443/v1
# MODEL_HOST=192.168.1.251                       # resolves slm.taco.internal inside the containers
# INFERENCE_CA_FILE=/run/taco-certs/root_ca.crt
# INFERENCE_CLIENT_CERT_FILE=/run/taco-certs/tls.crt
# INFERENCE_CLIENT_KEY_FILE=/run/taco-certs/tls.key
# The harnesses and app-mode load go through app-gateway with HTTP Basic (secrets/users/password):
# APP_AUTH_MODE=authelia
