FROM docker.io/library/python:3.12-slim

# Build context is the repository root (see tools/compose.yaml). One image runs every disposable
# evaluation, load, and report command, and the test suites. CPU only; runs on either host.
WORKDIR /app
COPY shared/requirements/tools.txt /tmp/tools.txt
RUN pip install --no-cache-dir -r /tmp/tools.txt
COPY shared/ /opt/shared/
RUN pip install --no-cache-dir --no-deps /opt/shared

COPY tools/taco_tools/ /app/taco_tools/
COPY tools/quality-gates.yaml tools/rubric.md /app/

# tools/compose.yaml mounts the repository's results/ at /app/results and sets RESULTS_DIR per service.
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    RESULTS_DIR=/app/results
RUN mkdir -p /app/results

ENTRYPOINT ["python", "-m"]
CMD ["taco_tools.serving.smoke_test", "--help"]
