# Module 2 settings. Copy to .env (git-ignored) and edit:  cp .env.example .env
# Compose reads this file for ${VAR} interpolation in compose.yaml. The API key is NOT set here; it is a
# runtime-mounted secret file (see secrets/README.md).

# Inference connection contract (module 1 gateway on the GPU host)
INFERENCE_BASE_URL=http://<MODEL_HOST>:8080/v1
INFERENCE_MODEL=qwen3.5-9b
INFERENCE_TIMEOUT_SECONDS=120
# Per-model request extras. Qwen: disable thinking. Llama and Mistral: use '{}'.
INFERENCE_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
# native = model tool calls parsed by vLLM (--tool-call-parser). A schema-based adapter is out of scope.
INFERENCE_TOOL_CALLING=native
# json_schema = guided decoding for the final proposal; none = prompt-only JSON
INFERENCE_STRUCTURED_OUTPUT=json_schema

# Agent limits
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_OUTPUT_TOKENS=800

# Application context
TACO_POLICY_VERSION=2026.09
TACO_ACTOR=rep-kop-01

# Host paths for results (relative to m2/)
RESULTS_DIR=./results
M1_RESULTS_DIR=../m1/results
